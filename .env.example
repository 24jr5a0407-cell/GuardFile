# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=trustvault_super_secret_cryptographic_jwt_key_2026_safe
JWT_EXPIRES_IN=1h

# Database Configuration (PostgreSQL)
# For remote PostgreSQL (e.g. Supabase/Neon/Render/Railway), provide DATABASE_URL:
# DATABASE_URL=postgres://user:password@localhost:5432/trustvault
# If DATABASE_URL is not set, TrustVault automatically uses embedded PostgreSQL (PGlite)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=trustvault

# Secure Storage Directory (isolated outside web root)
STORAGE_DIR=./secure_storage

# Email / OTP 2FA Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=guardfile@gmail.com
SMTP_PASS=khei qwkv rwbn mwcm
SMTP_FROM="TrustVault Security" <guardfile@gmail.com>

# Security Policies
MAX_FILE_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,docx,xlsx,csv
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
