{
  "name": "trustvault-guardfile",
  "version": "1.0.0",
  "description": "TrustVault — Secure zero-trust document sharing platform with immutable audit trail (Snovasys Fresher Hiring Challenge 2026)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:security": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/security.test.js --runInBand --forceExit",
    "verify-audit": "node -e \"require('./src/services/auditService').verifyChain().then(r => console.log('Audit Chain Valid:', r))\""
  },
  "keywords": [
    "security",
    "zero-trust",
    "audit-trail",
    "rbac",
    "document-management",
    "immutable-ledger",
    "snovasys-challenge"
  ],
  "author": "TrustVault Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "file-type": "^21.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.19.0",
    "sqlite3": "^6.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
